{
  "name": "fintech-logos-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "normalize": "tsx scripts/normalize.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "build": "npm run validate && npm run build:registry && npm run build --workspaces --if-present",
    "pretest": "npm run build:registry",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.9.9",
    "svgo": "^4.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
