{
  "name": "fintech-logos-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "normalize": "tsx scripts/normalize.ts",
    "build:registry": "tsx scripts/build-registry.ts",
    "build": "npm run validate && npm run build:registry && npm run build --workspaces --if-present",
    "pretest": "npm run build:registry",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "tsx scripts/preview.ts",
    "size": "tsx scripts/bundle-size.ts",
    "sources:sync": "tsx scripts/sync-sources.ts",
    "coverage": "tsx scripts/coverage.ts",
    "import": "tsx scripts/import-logos.ts",
    "version-packages": "changeset version && prettier --write .",
    "release": "npm run build && changeset publish",
    "changeset": "changeset",
    "replace-logo": "tsx scripts/replace-logo.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "esbuild": "^0.27.7",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
