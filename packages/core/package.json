{
  "name": "banklogos",
  "version": "0.1.0",
  "description": "Official logos for banks, microfinance banks, mobile money and wallets, looked up by bank code or name. Nigeria first, expanding worldwide.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svg/*": {
      "types": "./dist/generated/svg/*.d.ts",
      "import": "./dist/generated/svg/*.js",
      "require": "./dist/generated/svg/*.cjs"
    },
    "./img/*": {
      "import": {
        "types": "./dist/generated/img/*.d.ts",
        "default": "./dist/generated/img/*.js"
      },
      "require": {
        "types": "./dist/generated/img/*.d.cts",
        "default": "./dist/generated/img/*.cjs"
      }
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "bank logos",
    "banks",
    "bank codes",
    "logos",
    "nigeria",
    "africa",
    "microfinance",
    "mobile-money",
    "fintech",
    "payments",
    "svg",
    "webp"
  ],
  "scripts": {
    "build": "tsup && tsx ../../scripts/write-image-modules.ts",
    "prepack": "node ../../scripts/prepack-check.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": "true"
  },
  "author": "Basit",
  "homepage": "https://github.com/folabas/banklogos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folabas/banklogos.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/folabas/banklogos/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
