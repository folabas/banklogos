{
  "name": "fintech-logos",
  "version": "0.0.0",
  "description": "Logos for banks, mobile money, e-wallets, payment gateways and crypto \u2014 starting with Nigeria.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svg/*": {
      "types": "./dist/generated/svg/*.d.ts",
      "import": "./dist/generated/svg/*.js",
      "require": "./dist/generated/svg/*.cjs"
    },
    "./img/*": {
      "import": {
        "types": "./dist/generated/img/*.d.ts",
        "default": "./dist/generated/img/*.js"
      },
      "require": {
        "types": "./dist/generated/img/*.d.cts",
        "default": "./dist/generated/img/*.cjs"
      }
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "logos",
    "fintech",
    "banks",
    "nigeria",
    "africa",
    "mobile-money",
    "payments",
    "crypto",
    "svg"
  ],
  "scripts": {
    "build": "tsup && tsx ../../scripts/write-image-modules.ts"
  }
}
